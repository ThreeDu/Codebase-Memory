  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "code-index",
    "codebase",
    "claude-code",
    "cursor"
  ],
  "author": "Khang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeDu/Codebase-Memory.git"
  },
  "homepage": "https://github.com/ThreeDu/Codebase-Memory#readme",
  "bugs": "https://github.com/ThreeDu/Codebase-Memory/issues",
